# ─────────────────────────────────────────────────────────────
# Environment template — copy to .env and fill real values.
# .env is git-ignored; never commit secrets.
# ─────────────────────────────────────────────────────────────

# MySQL connection (required)
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://app:app_password@127.0.0.1:3306/app_db"

# Authentication (required in production; ≥32 random chars)
# Example generator: openssl rand -base64 48
JWT_ACCESS_SECRET=""
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="7"

# Express API package (apps/api)
API_PORT="4100"
CORS_ORIGIN="http://localhost:3000"

# SMS gateway (optional — without these, SMS is recorded as SIMULATED)
SMS_API_URL=""
SMS_API_KEY=""

# Node
NODE_ENV="development"
